{
  "name": "jvjvjv/code-talker",
  "description": "Multi-provider AI communications package for Laravel — chatbots, streaming, tool-use, memory, and admin management.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "ai",
    "llm",
    "chatbot",
    "anthropic",
    "openai",
    "gemini",
    "grok",
    "streaming"
  ],
  "authors": [
    {
      "name": "Jason Vertucio",
      "email": "bigcartoonjay@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.62 || ^13.15",
    "laravel/ai": "^0.9",
    "guzzlehttp/guzzle": "^7.0",
    "symfony/dom-crawler": "^7.4 || ^8.1",
    "laravel/mcp": "^0.8.1"
  },
  "suggest": {
    "bspdx/keystone": "Suggested for host-app authorization around admin AI routes and related access control wiring."
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": [
      "@php vendor/bin/phpunit"
    ],
    "version": [
      "@php -r \"echo 'Current version: '; passthru('git describe --tags --abbrev=0 2>/dev/null || echo No version tags yet');\""
    ],
    "version:list": [
      "@php -r \"echo 'All version tags:' . PHP_EOL; passthru('git tag -l | sort -V');\""
    ],
    "version:release": [
      "bash bin/release"
    ]
  },
  "autoload": {
    "psr-4": {
      "Jvjvjv\\CodeTalker\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jvjvjv\\CodeTalker\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Jvjvjv\\CodeTalker\\CodeTalkerServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
